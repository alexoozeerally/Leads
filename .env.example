# -----------------------------------------------------------------------------
# AI Web-Design Lead Finder — example environment.
# Copy to .env and adjust. No secrets are committed; defaults run fully offline.
# -----------------------------------------------------------------------------

# --- Application ---
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database ---
# Local default is SQLite (no external service needed).
DATABASE_URL=sqlite+aiosqlite:///./leadfinder.db
# For Postgres (Docker compose sets this automatically):
# DATABASE_URL=postgresql+asyncpg://leadfinder:leadfinder@db:5432/leadfinder
DB_ECHO=false

# --- Anthropic / AI ---
# Leave blank to use the deterministic MOCK client (offline, no cost).
# Set a real key to call the live API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=2048
AGENT_MAX_RETRIES=2

# --- Business discovery ---
BUSINESS_PROVIDER=csv
CSV_PROVIDER_PATH=tests/fixtures/sample_businesses.csv
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Crawler / compliance ---
# Use a TRUTHFUL, identifying User-Agent. Respect robots.txt. Rate-limit.
CRAWLER_USER_AGENT=LeadFinderBot/0.1 (+https://example.com/leadfinderbot; UK web-design prospecting; respects robots.txt; contact: hello@example.com)
CRAWLER_RATE_LIMIT_PER_HOST=1.0
CRAWLER_TIMEOUT_SECONDS=30
CRAWLER_RESPECT_ROBOTS=true
SCREENSHOT_DIR=./data/screenshots

# --- Pipeline / robustness ---
REAUDIT_AFTER_DAYS=30
